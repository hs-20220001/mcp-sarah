MCP_REQUEST_TIMEOUT_MS=30000
MCP_CONFIRMATION_TTL_SECONDS=900
# true exige CONFIRMO; false mantém token, diff e preflight sem pedir confirmação humana.
MCP_REQUIRE_CONFIRMATION=true
MCP_AUDIT_LOG_PATH=.local/audit.jsonl
MCP_TFS_POLICY_PATH=config/tfs-sarah.yaml
MCP_WORDPRESS_POLICY_PATH=config/wordpress.yaml
# Use os dois caminhos abaixo para políticas diferentes por wiki; se vazios, usa MCP_WORDPRESS_POLICY_PATH.
MCP_WORDPRESS_USER_POLICY_PATH=
MCP_WORDPRESS_DEVELOPER_POLICY_PATH=
MCP_DASHBOARD_PORT=3333
# Use false para impedir que npm run dev abra o navegador automaticamente.
MCP_DASHBOARD_OPEN=true
# Proteção do smoke test real; deixe vazio no uso normal.
MCP_LIVE_TESTS=

# Azure DevOps Server / TFS
AZURE_DEVOPS_ORG_URL=https://tfs.example.org/tfs/DefaultCollection
AZURE_DEVOPS_PROJECT=Sarah
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_API_VERSION=7.0

# WordPress
# Compatibilidade: uma única wiki, tratada como wiki pública dos usuários.
WP_BASE_URL=https://docs.example.org
# Para duas wikis, prefira preencher WP_USER_BASE_URL e WP_DEVELOPER_BASE_URL.
WP_USER_BASE_URL=
WP_DEVELOPER_BASE_URL=
WP_USERNAME=
WP_APPLICATION_PASSWORD=
# Caminhos absolutos separados por ; no Windows e por : em POSIX. Vazio permite qualquer caminho local.
WP_ALLOWED_MEDIA_ROOTS=

# Oracle Database (Thin mode por padrão; preencha os perfis necessários)
# Para autenticação legada incompatível com Thin mode, aponte para Oracle Instant Client 19+.
ORACLE_CLIENT_LIB_DIR=
# Opcional no modo Thick: diretório TNS compartilhado; usa ORACLE_TNS_ADMIN_DEV se vazio.
ORACLE_CLIENT_CONFIG_DIR=
# DEV é sempre o ambiente padrão. HOM/PRO só são usados quando solicitados explicitamente.
ORACLE_CONNECT_STRING_DEV=localhost:1521/FREEPDB1
ORACLE_USER_DEV=app_readonly_dev
ORACLE_PASSWORD_DEV=
# Diretório que contém tnsnames.ora quando connect string for um alias TNS (ex.: BSBDSV).
ORACLE_TNS_ADMIN_DEV=
# Lista OWNER.PACKAGE.FUNCTION separada por vírgulas; vazia permite todas as funções compatíveis.
ORACLE_READONLY_FUNCTIONS_DEV=
ORACLE_CONNECT_STRING_HOM=
ORACLE_USER_HOM=
ORACLE_PASSWORD_HOM=
ORACLE_TNS_ADMIN_HOM=
ORACLE_READONLY_FUNCTIONS_HOM=
ORACLE_CONNECT_STRING_PRO=
ORACLE_USER_PRO=
ORACLE_PASSWORD_PRO=
ORACLE_TNS_ADMIN_PRO=
ORACLE_READONLY_FUNCTIONS_PRO=
